<template>
  <div class="page">
    <list class="list">
      <list-item class="list-item-title">
        <div class="title-box">
          <text class="header-title">随机一言</text>
        </div>
      </list-item>
      <list-item class="list-item-content">
        <div class="saying-box">
          <text class="saying-text">{{saying || '点击下方按钮获取一言'}}</text>
        </div>
      </list-item>
      <list-item class="list-item-btn">
        <div class="refresh-btn" @click="getSaying">
          <text class="refresh-text">获取一言</text>
        </div>
      </list-item>
    </list>

    <div class="loading-mask" show="{{loading}}">
      <div class="loading-box">
        <text class="loading-text">加载中...</text>
      </div>
    </div>
  </div>
</template>

<style>
  .page {
    width: 240px;
    height: 240px;
    background-color: #0a0a0a;
    flex-direction: column;
  }
  .list {
    flex: 1;
    width: 240px;
  }
  .list-item-title {
    width: 240px;
    height: 48px;
  }
  .title-box {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
  }
  .header-title {
    font-size: 28px;
    color: #ffffff;
    font-weight: bold;
  }
  .list-item-content {
    width: 240px;
  }
  .saying-box {
    width: 220px;
    margin-left: 10px;
    margin-right: 10px;
    background-color: #1a1a1a;
    border-radius: 14px;
    border-width: 1px;
    border-color: #2a2a2a;
    padding: 16px;
    justify-content: center;
    align-items: center;
  }
  .saying-text {
    font-size: 24px;
    color: #ffffff;
    text-align: center;
    line-height: 1.6;
  }
  .list-item-btn {
    width: 240px;
    height: 66px;
  }
  .refresh-btn {
    width: 220px;
    height: 54px;
    margin-left: 10px;
    margin-right: 10px;
    background-color: #1691fa;
    border-radius: 27px;
    justify-content: center;
    align-items: center;
  }
  .refresh-btn:active {
    background-color: #0d7ad0;
  }
  .refresh-text {
    font-size: 26px;
    color: #ffffff;
    font-weight: bold;
  }
  .loading-mask {
    position: fixed;
    top: 0;
    left: 0;
    width: 240px;
    height: 240px;
    background-color: rgba(0, 0, 0, 0.75);
    justify-content: center;
    align-items: center;
  }
  .loading-box {
    background-color: #1a1a1a;
    border-radius: 14px;
    padding: 20px 30px;
    border-width: 1px;
    border-color: #2a2a2a;
  }
  .loading-text {
    font-size: 24px;
    color: #ffffff;
  }
</style>

<script>
  import fetch from '@system.fetch';
  import prompt from '@system.prompt';

  export default {
    data: {
      saying: '',
      loading: false
    },
    onInit() {
      this.getSaying();
    },
    getSaying() {
      if (this.loading) return;
      this.loading = true;
      fetch.fetch({
        url: 'https://uapis.cn/api/v1/saying',
        method: 'GET',
        success: (res) => {
          try {
            let data = JSON.parse(res.data);
            if (data.text) {
              this.saying = data.text;
            } else {
              prompt.showToast({ message: '获取失败' });
              this.saying = '获取失败，请稍后再试';
            }
          } catch (e) {
            prompt.showToast({ message: '数据解析失败' });
            this.saying = '获取失败，请稍后再试';
          }
          this.loading = false;
        },
        fail: () => {
          prompt.showToast({ message: '网络请求失败' });
          this.saying = '网络连接失败，请检查网络';
          this.loading = false;
        }
      });
    }
  };
</script>